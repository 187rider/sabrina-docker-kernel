@@ -638,6 +638,68 @@ static unsigned long expand_and_crc_sym(struct symbol *sym, unsigned long crc)
 	return crc;
 }
 
+
+/* STOCK SYMBOL CRC OVERRIDE HOOK */
+struct ref_crc_entry {
+    char *name;
+    unsigned long crc;
+    struct ref_crc_entry *next;
+};
+
+#define REF_CRC_HASH_SIZE 16384
+static struct ref_crc_entry *ref_crc_table[REF_CRC_HASH_SIZE];
+static int ref_crc_loaded = 0;
+
+static unsigned int ref_crc_hash(const char *s)
+{
+    unsigned int h = 5381;
+    while (*s)
+        h = ((h << 5) + h) + (unsigned char)*s++;
+    return h % REF_CRC_HASH_SIZE;
+}
+
+static void load_stock_crcs(const char *path)
+{
+    FILE *f = fopen(path, "r");
+    char line[256];
+    if (!f) return;
+    while (fgets(line, sizeof(line), f)) {
+        unsigned long crc;
+        char name[128];
+        if (sscanf(line, "%lx %127s", &crc, name) == 2 ||
+            sscanf(line, "0x%lx %127s", &crc, name) == 2) {
+            unsigned int h = ref_crc_hash(name);
+            struct ref_crc_entry *e = malloc(sizeof(*e));
+            e->name = strdup(name);
+            e->crc = crc;
+            e->next = ref_crc_table[h];
+            ref_crc_table[h] = e;
+        }
+    }
+    fclose(f);
+    ref_crc_loaded = 1;
+}
+
+static int lookup_stock_crc(const char *name, unsigned long *out_crc)
+{
+    if (!ref_crc_loaded) {
+        const char *p = getenv("GENKSYMS_STOCK_SYMVERS");
+        if (!p) p = "/kbuild/stock_symvers.txt";
+        load_stock_crcs(p);
+    }
+    unsigned int h = ref_crc_hash(name);
+    struct ref_crc_entry *e = ref_crc_table[h];
+    while (e) {
+        if (strcmp(e->name, name) == 0) {
+            *out_crc = e->crc;
+            return 1;
+        }
+        e = e->next;
+    }
+    return 0;
+}
+/* END STOCK SYMBOL CRC OVERRIDE HOOK */
